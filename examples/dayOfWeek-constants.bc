# Day of week with constants set using initial values
# This shows how much cleaner it is vs hundreds of manual give statements

take Out next self
take tmp next self
take tmp2 next self

copyMonth: take Month refillMonth
give tmp
give tmp2 copyMonth
refillMonth: take tmp2 checkMonth
give Month prev

# Check if m < 3
checkMonth: take tmp decYear
take tmp decYear
take tmp decYear terms

decYear: take Year terms terms

terms: take sum y self
# +y
y: use "copy" From=Year To=sum tmp=tmp2

# Instead of 500+ lines of manual division, use constants
# Set up 4 and do manual division by 4
use "copy" From=4 To=divisor
leap: use "copy" From=Year To=tmp tmp=tmp2
leapDiv: take tmp centuryStart
         take divisor leapRestore
         give sum leapDiv
leapRestore: give divisor leapDiv

# Set up 100 for century calculation  
centuryStart: use "copy" From=100 To=divisor
              use "copy" From=Year To=tmp tmp=tmp2
century: take tmp FourhundredStart
         take divisor centRestore
         take sum halt century
centRestore: give divisor century

# Set up 400 for four hundred year correction
FourhundredStart: use "copy" From=400 To=divisor
                  use "copy" From=Year To=tmp tmp=tmp2
fourhundred: take tmp lookupStart
             take divisor fourRestore  
             give sum fourhundred
fourRestore: give divisor fourhundred

lookupStart: take Month halt
take Month day
take Month lookup3
take Month lookup2
take Month lookup5
take Month day
take Month lookup3
take Month lookup5
take Month lookup1
take Month lookup4
take Month lookup6
take Month lookup2
take Month lookup4

lookup6: give sum
lookup5: give sum
lookup4: give sum
lookup3: give sum
lookup2: give sum
lookup1: give sum

day: use "copy" From=Day To=sum tmp=tmp2

modout: take sum out0
take sum out1
take sum out2
take sum out3
take sum out4
take sum out5
take sum out6 modout

out6: give Out
out5: give Out
out4: give Out
out3: give Out
out2: give Out
out1: give Out
out0: stop