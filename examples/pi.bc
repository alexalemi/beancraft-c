# A spigot for pi:  print the first N decimal digits of pi (default 50).
#   ./beancraft -O examples/pi.bc N=100
#   3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117067
#
# Euler's series, nested:  pi = 2 + 1/3 (2 + 2/5 (2 + 3/7 (2 + ...))),  a tower of
# maps  x -> 2 + k x / (2k+1)  whose tails x all lie in [3, 4].  This is Gibbons'
# unbounded spigot (2006), with x written as 3 + y, y in [0, 1], so that every
# number the machine holds stays non-negative.  The composition so far is
#     f(y) = (q*y + b) / t
# and the machine alternates two moves:
#   consume  term k:   f := f(k (3 + y) / (2k+1) - 1)   i.e.
#                      b := b*(2k+1) + q*(k-1),   q := q*k,   t := t*(2k+1)
#   produce  a digit, as soon as f(0) and f(1) agree on it: d = b div t is safe
#            when (b mod t) + q < t; print d, then  f := 10*(f - d)  i.e.
#            b := 10*(b mod t),  q := 10*q
# Only a handful of registers, each a growing bignum, and no arrays -- which is
# what lets a counter machine run it.  Without -O every multiply and divide is
# done bean by bean and even "3.1" takes ~20 seconds; with -O they fold to
# bignum ops (MULADD, DIVBIN) and 400 digits take about a second.  e.bc is the same machine fed e's series.

use "std"

func putc C {                     # print the character with code C
  addn C con/byte
  give con/emit
}

func move From To {               # To := From, From := 0
  clear To
  l: - From done
     + To l
}

- N dflt                          # N == 0 (not given): 50 digits
+ N init0
dflt:  addn 50 N
init0: clear k
       clear m
       + m                        # m = 2k+1
       clear j                    # j = k-1 (bumped after use)
       clear q
       clear b
       clear t
       + q                        # f(y) = 3 + y:  q = 1, b = 3, t = 1
       addn 3 b
       + t
       clear first
       + first                    # the first digit gets no '.' before it;
       clear dot                  #   the second one does
       + dot

consume: + k
         + m
         + m
         mul b m nb               # b := b*(2k+1) + q*(k-1)
         mul q j qj
         move nb b
mvqj:    - qj mvq
         + b mvqj
mvq:     + j
         mul q k nq               # q := q*k
         move nq q
         mul t m nt               # t := t*(2k+1)
         move nt t

extract: divmod b t d r           # d := b div t,  r := b mod t
         copy r s                 # is it safe?  s := r + q;  s < t  <=>  s div t == 0
         addr q s
         divmod s t c junk
         - c digit consume        # not yet: consume another term

digit:   - N fin                  # printed enough?
         - first pdot pdig
pdot:    - dot pdig
         putc 46                  # '.'
pdig:    addn 48 con/byte         # print '0' + d
pd:      - d emit
         + con/byte pd
emit:    give con/emit
         mul r 10 b               # b := 10*r
         mul q 10 nq              # q := 10*q
         move nq q
         - c extract extract      # (c is 0 here; "goto extract")

fin:     putc 10
