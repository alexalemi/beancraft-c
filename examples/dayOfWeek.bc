# Compute the day of week using Sakamoto's method
# 
# dayofweek(y, m, d)  /* 1 <= m <= 12, y > 1752 */
# {
#   static int t[] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
#   if ( m < 3 )
#   {
#      y -= 1;
#   }
#   return (y + y/4 - y/100 + y/400 + t[m-1] + d) % 7;
#}

take Out next self
take tmp next self
take tmp2 next self
copyMonth: take Month refillMonth
give tmp
give tmp2 copyMonth
refillMonth: take tmp2 checkMonth
give Month prev

# check if m < 3
checkMonth: take tmp decYear
take tmp decYear
take tmp decYear terms

decYear: take Year terms terms

terms: take sum y self
# +y
y: use "copy" From=Year To=sum tmp=tmp2

# leap
leapStart: take tmp next self
take tmp2 next self
use "copy" From=Year To=tmp tmp=tmp2
leap: take tmp centuryStart
take tmp centuryStart
take tmp centuryStart
take tmp centuryStart
give sum leap

