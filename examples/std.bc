# Beancraft standard library -- the little register-machine subroutines that turn
# up in almost every program.  `use "std"` and call them by name; `use` only
# registers the func definitions, it generates no code of its own.
#
#   clear X              X := 0
#   copy From To         To := From               (From preserved; uses a private tmp)
#   addr From To         To += From               (From preserved)
#   addn N R             R += N                   (N a value argument, consumed)
#   subn N R             R := max(0, R - N)       (N consumed)
#   half X               X := floor(X / 2)
#   bit0 N R             R := N & 1               (N consumed)
#   mod3 R               R := R mod 3
#   mod4 R               R := R mod 4
#   iseq A B R           R := 1 if A == B else 0  (A, B consumed)
#   inrange A B SPAN R   R := 1 if B <= A < B+SPAN else 0   (A, B preserved; SPAN consumed)
#   note FREQ MS         queue a square-wave tone (audio device; FREQ, MS consumed)
#   mul A B R            R := A * B               (A, B preserved; R distinct from both)
#   divmod N D Q REM     Q := N div D, REM := N mod D   (N, D preserved; D == 0 gives Q := 0, REM := N)
#   printnum N           print N in decimal on the console (N preserved)
#   sub A B R ~under     R := A - B; if B > A, R := 0 and jump to under   (A, B preserved)
#   isqrt N R            R := floor(sqrt(N))      (N preserved)
#   readnum N ~eof       N := the next decimal number typed on the console, skipping
#                        anything that isn't a digit; EOF before a digit -> jump to eof
#
# mul, divmod and sub are written in exactly the shapes the -O optimizer folds (MULADD,
# DIVBIN), so with -O each is a handful of bignum operations whatever the size of
# the numbers; without -O they cost on the order of A*B and N steps.

func clear X { - X done self }

func copy From To {                                # To := From   (From preserved)
  - tmp clrTo self
  clrTo: - To loop self
  loop:  - From restore
         + To
         + tmp loop
  restore: - tmp done
           + From restore
}

func addr From To {                                # To += From   (From preserved)
  - tmp loop self
  loop:  - From restore
         + To
         + tmp loop
  restore: - tmp done
           + From restore
}

func addn N R {                                    # R += N   (N consumed)
  l: - N done
  + R l
}

func subn N R {                                    # R := max(0, R - N)   (N consumed)
  l: - N done
  - R l l
}

func half X {                                      # X := floor(X / 2)
  - q qz self
  qz: - X mv q1
  q1: - X mv q2
  q2: + q qz
  mv: - q done qm
  qm: + X mv
}

func bit0 N R {                                    # R := N & 1   (N consumed)
  - R r0 self
  r0: - N done dec1
  dec1: - N r1 r0
  r1: + R
}

func mod3 R {                                      # R := R mod 3
  m0: - R done m1
  m1: - R e1 m2
  m2: - R e2 m3
  m3: - z m0
  e1: + R done
  e2: + R e2b
  e2b: + R done
}

func mod4 R {                                      # R := R mod 4
  m0: - R done m1
  m1: - R e1 m2
  m2: - R e2 m3
  m3: - R e3 m4
  m4: - z m0
  e1: + R done
  e2: + R e2b
  e2b: + R done
  e3: + R e3b
  e3b: + R e3c
  e3c: + R done
}

func note FREQ MS {                                # queue a square-wave tone: FREQ Hz for MS ms
  clear audio/freq
  addn FREQ audio/freq
  clear audio/duration
  addn MS audio/duration
  give audio/play
}

func iseq A B R {                                  # R := 1 if A == B else 0   (A, B consumed)
  - R c0 self                                      # R := 0
  c0: - A aZ aN
  aZ: - B yes done                                 # A==0: B==0 -> equal; B>0 -> A<B, not equal
  aN: - B done c0                                  # A>0:  B==0 -> A>B, not equal; B>0 -> loop
  yes: + R
}

func inrange A B SPAN R {                           # R := 1 if B <= A < B+SPAN else 0  (A, B kept; SPAN consumed)
  - R r0 self                                      # R := 0
  r0: copy A a
      copy B b
  # phase 1: lockstep-decrement a and b
  p1:  - b p2 p1a
  p1a: - a done p1b                                # a hits 0 while b>0 -> A < B -> not in range
  p1b: - z p1
  # phase 2: a = A-B >= 0.  c := SPAN-1; lockstep-decrement a and c
  p2:   - c c0 self                                # c := 0
  c0:   - SPAN cset cdec                           # c := SPAN, SPAN := 0
  cdec: + c c0
  cset: - c c2 c2                                  # c := SPAN - 1  (SPAN==0 -> c stays 0)
  c2:   - a yes c3                                 # a hits 0 first/together -> A-B <= SPAN-1 -> in range
  c3:   - c done c4                                # c hits 0 while a>0 -> A-B >= SPAN -> not in range
  c4:   - z c2
  yes:  + R
}

func mul A B R {                                   # R := A * B   (A, B preserved)
  clear R
  clear tmp
  copy B c
  l: - c done                                      # c times:  R += A  (A restored through tmp)
  a: - A r
     + R
     + tmp a
  r: - tmp l
     + A r
}

func divmod N D Q REM {                            # Q := N div D, REM := N mod D  (N, D preserved)
  clear Q
  copy N n
  copy D d
  - d byZero                                       # D == 0: no division to do
  + d z
  z: - REM next self                               # REM := 0
  s: - d full                                      # take a bean from d and one from n together,
     - n done                                      #   counting the pairs in REM;
     + REM s
  full: - REM q                                    # d ran dry: a whole D came out of n, so pour
        + d full                                   #   REM back into d and count one in Q
  q:    + Q s
  byZero: copy N REM
}

func printnum N {                                  # print N in decimal (N preserved)
  copy N n
  clear stk                                        # the digits, last first, as base-11 "digit+1"s
  push: divmod n 10 q r                            #   (so a 0 digit is a 1 and no zero gets lost)
        mul stk 11 t
        - stk mvT self
  mvT:  - t addR
        + stk mvT
  addR: - r more
        + stk addR
  more: + stk                                      # the +1
        - n mvQ self
  mvQ:  - q again
        + n mvQ
  again: - n pop                                   # loop while n > 0  (so N == 0 still prints "0")
         + n push
  pop:  divmod stk 11 q r                          # r = digit+1
        - stk mvQ2 self
  mvQ2: - q emit
        + stk mvQ2
  emit: addn 47 con/byte
  dig:  - r out
        + con/byte dig
  out:  give con/emit
        - stk done
        + stk pop
}

func sub A B R ~under {                            # R := A - B, or jump to under if B > A
  clear q                                          # The divmod loop again, dividing B by A+1:
  copy A p                                         #   it takes beans from p = A+1 and B in
  + p                                              #   lockstep, so if B <= A it stops with
  copy B b                                         #   p = A - B left over (and q = 0); if
  z: - rem next self                               #   B > A, p runs dry first and q counts it.
  s: - p full
     - b out
     + rem s
  full: - rem qq
        + p full
  qq:   + q s
  out:  clear R
  mv:   - p chk
        + R mv
  chk:  - q done
        clear R
        - q under under
}

func isqrt N R {                                   # R := floor(sqrt(N))   (Newton; see isqrt.bc)
  clear R
  - N done
  + N
  copy N x
  l: divmod N x t r
     divmod t x c r
     - c st
     copy x R
     - c done done
  st: - t h
      + x st
  h:  half x
      - c l l
}

func readnum N ~eof {                              # N := next number on the console
  clear N
  skip: - con/read eof                             # skip to the first digit
        clear ch
  mv1:  - con/byte chk1
        + ch mv1
  chk1: inrange ch 48 10 isd
        - isd skip
  dig:  mul N 10 t                                 # N := 10*N + digit
        clear N
  mvt:  - t addd
        + N mvt
  addd: subn 48 ch
  mvd:  - ch more
        + N mvd
  more: - con/read done                            # EOF ends the number too
  mv2:  - con/byte chk2
        + ch mv2
  chk2: inrange ch 48 10 isd
        - isd fin dig                              # a non-digit ends it (and is eaten)
  fin:  clear ch
}
