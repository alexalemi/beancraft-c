# W moves (yours, or the practice opponent's), then it's B's turn
w4to1: - w4 bug
       - b1 wp41 wp41             # (a capture empties the B bin)
wp41:  + w1 myTurn
w4to2: - w4 bug
       - b2 wp42 wp42             # (a capture empties the B bin)
wp42:  + w2 myTurn
w5to1: - w5 bug
