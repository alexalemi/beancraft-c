# box 0: ..B / .WB / ...   m1: 3-5  m2: 6-9
box0:  clear tot
       addr box0m1 tot
       addr box0m2 tot
       - tot resign               # an empty box: no move left worth making
       + tot
       give rand/next             # r := a random bean, 0 .. tot-1
       divmod rand/byte tot q r
b0d0:  copy box0m1 c
b0d0l: - c b0d1
       - r b0p0 b0d0l
b0d1:  copy box0m2 c
b0d1l: - c b0p1
       - r b0p1 b0d1l
b0p0:  clear c
       clear last
       addn 1 last                # remember the bean: box0m1
       - z b3to5 b3to5
b0p1:  clear c
       clear last
       addn 2 last                # remember the bean: box0m2
       - z b6to9 b6to9
