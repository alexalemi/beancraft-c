human: clear res
board: show w1 b1 49               # print the board ...
       show w2 b2 50
       show w3 b3 51
       putc 10
       show w4 b4 52
       show w5 b5 53
       show w6 b6 54
       putc 10
       show w7 b7 55
       show w8 b8 56
       show w9 b9 57
       putc 10
       - res ask                  # ... then: your move (res = 0),
       - res msgB                 #   or B won (1),
       - res msgW                 #   you won (2),
       - res msgR msgR            #   B resigned (3)

