       - w2 free42
       + w2 bad
free42: if1 b2 bad                 # diagonal: must capture
       - z w4to2 w4to2
chk5to1: if1 w5 bad                # your pawn there?
       - w1 free51
       + w1 bad
free51: if1 b1 bad                 # diagonal: must capture
       - z w5to1 w5to1
chk5to2: if1 w5 bad                # your pawn there?
       - w2 free52
       + w2 bad
free52: - b2 w5to2                 # straight on: must be empty
       + b2 bad
chk5to3: if1 w5 bad                # your pawn there?
       - w3 free53
       + w3 bad
free53: if1 b3 bad                 # diagonal: must capture
       - z w5to3 w5to3
