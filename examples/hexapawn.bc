# ---- the end of a game -----------------------------------------------------------
bWins: clear kind
       + kind over
resign: clear kind
       addn 3 kind
       - z punish punish
wWins: clear kind
       addn 2 kind
punish: - last over               # B lost: take away the bean it played last
       - last pun1
       - last pun2
       - last pun3
       - last pun4
       - last pun5
       - last pun6
       - last pun7
       - last pun8
