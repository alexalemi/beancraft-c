# ---- your move: a practice game picks one at random; otherwise you type it -----
wpos0: - T human                  # ... / BWB / ...
       + T
       - z w5to2 w5to2
wpos1: - T human                  # ... / WBW / ...
       + T
       give rand/next
       divmod rand/byte 2 q r
       - r w4to1
       - z w6to3 w6to3
wpos2: - T human                  # ..B / .BB / W..
       + T
       give rand/next
       divmod rand/byte 2 q r
       - r w7to4
       - z w7to5 w7to5
wpos3: - T human                  # ..B / BB. / ..W
       + T
       give rand/next
       divmod rand/byte 2 q r
       - r w9to6
       - z w9to5 w9to5
