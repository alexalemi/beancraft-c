over:  - T real
       - kind lost1               # a practice game: print W or L
       - kind won1
lost1: clear kind
       putc 76                    # 'L'
       - z col col
won1:  putc 87                    # 'W'
col:   - cd row row               # 50 to a line
row:   - cd nl
       + cd more
nl:    putc 10
       addn 50 cd
more:  - T done1
       + T newGame
done1: putc 10                    # "\nnow it's your turn.\n\n"
       putc 110
       putc 111
       putc 119
       putc 32
       putc 105
       putc 116
       putc 39
       putc 115
       putc 32
       putc 121
       putc 111
       putc 117
       putc 114
       putc 32
       putc 116
       putc 117
       putc 114
       putc 110
       putc 46
       putc 10
       putc 10
       - z newGame newGame
real:  copy kind res              # show the final board, then the verdict
       - kind bug
       - kind iWon
       + lost board
iWon:  clear kind
       + won board
msgB:  putc 73                    # 'I win.\n'
       putc 32
       putc 119
       putc 105
       putc 110
       putc 46
       putc 10
       - z score score
msgW:  putc 89                    # "You win. I'll remember that.\n"
       putc 111
       putc 117
       putc 32
       putc 119
       putc 105
       putc 110
       putc 46
       putc 32
       putc 73
       putc 39
       putc 108
       putc 108
       putc 32
       putc 114
       putc 101
       putc 109
       putc 101
       putc 109
       putc 98
       putc 101
       putc 114
       putc 32
       putc 116
       putc 104
       putc 97
       putc 116
       putc 46
       putc 10
       - z score score
msgR:  putc 73                    # "I resign. I'll remember that.\n"
       putc 32
       putc 114
       putc 101
       putc 115
       putc 105
       putc 103
       putc 110
       putc 46
       putc 32
       putc 73
       putc 39
       putc 108
       putc 108
       putc 32
       putc 114
       putc 101
       putc 109
       putc 101
       putc 109
       putc 98
       putc 101
       putc 114
       putc 32
       putc 116
       putc 104
       putc 97
       putc 116
       putc 46
       putc 10
score: putc 109                   # 'me '
       putc 101
       putc 32
       printnum won
       putc 44                    # ', you '
       putc 32
       putc 121
       putc 111
       putc 117
       putc 32
       printnum lost
       putc 10                    # '\n\n'
       putc 10
       - z newGame newGame

bug:   stop
eof:
